/*
 * This file is enforced by schema file located at 'bga-ts-template/template/schema'. If you are using VS Code, this schema file will be linked to this file automatically if 'generate-vscode-files' is set to true in 'template.config.jsonc. Hover over any fields for more information.
 *
 * Game state machine is a tool used to facilitate game development. Please check the BGA Studio presentation about game state to understand this, and associated documentation.
 *
 * !! It is not a good idea to modify this file when a game is running !!
 */
{
	"$schema": "../../node_modules/bga-ts-template/schema/gamestates.schema.json",

	// The initial state. Please do not modify.
	"1": {
		"name": "gameSetup",
		"description": "",
		"type": "manager",
		"action": "stGameSetup",
		"transitions": { "": 2 }
	},

	// Note: ID=2: your first state. If not, change the transition in the gameSetup above.
	"2": {
		"name": "playerTurnAsk",
		"description": "${actplayer} may play a question card or redraw their hand",
		"descriptionmyturn": "${you} may play a question card or redraw your hand",
		"type": "activeplayer",
		"possibleactions": {
			"actPlayCard": [{ "name": "card_id", "type": "AT_int" }, { "name": "target_id", "type": "AT_int" }],
			"actDiscardAndRedraw": []
		},
		"transitions": { "getResponses": 3, "guessPhase": 4, "nextPlayer": 10 }
	},

	"3": {
		"name": "targetResponse",
		"description": "Waiting for responses from other players",
		"descriptionmyturn": "${you} must respond to the question.  What is your answer?",
		"type": "multipleactiveplayer",
		"possibleactions": {
			"actGiveAnswer": [{ "name": "response", "type": "AT_alphanum"}]
		},
		"transitions": { "reportAnswer": 4 },
		"action": "stMultiPlayerInit"
	},

	"4": {
		"name": "playerTurnGuess",
		"description": "${actplayer} may make a guess or end their turn",
		"descriptionmyturn": "${you} may make a guess or end your turn",
		"type": "activeplayer",
		"possibleactions": {
			"actGuess": [{ "name": "target_id", "type": "AT_alphanum"}, { "name": "tribe", "type": "AT_alphanum" }, { "name": "number", "type": "AT_int" }],
			"actPass": []
		},
		"transitions": { "endGame": 99, "nextPlayer": 10, "joinGuess": 5 }
	},

	// "Everyone may join a guess" option: after the active player makes a
	// (secret) guess, everyone except them and the target may guess the same
	// target's identity.
	"5": {
		"name": "joinGuess",
		"description": "Other players may also guess the identity of ${target_name}",
		"descriptionmyturn": "${you} may also guess the identity of ${target_name}",
		"type": "multipleactiveplayer",
		"action": "stJoinGuess",
		"args": "argJoinGuess",
		"argsType": { "guesser_id": "number", "target_id": "number", "target_name": "string" },
		"possibleactions": {
			"actJoinGuess": [{ "name": "tribe", "type": "AT_alphanum" }, { "name": "number", "type": "AT_int" }],
			"actDeclineGuess": []
		},
		"transitions": { "resolveGuess": 6 }
	},

	// Reveals every guess made during joinGuess and scores them.
	"6": {
		"name": "gameResolveGuess",
		"description": "Revealing all guesses",
		"type": "game",
		"action": "stResolveGuess",
		"updateGameProgression": true,
		"transitions": { "nextPlayer": 10, "endGame": 99 }
	},

	"10": {
		"name": "gameNextPlayer",
		"description": "",
		"type": "game",
		"action": "stNextPlayer",
		"updateGameProgression": true,
		"transitions": { "endGame": 99, "continueGame": 2 }
	},

/*
	// Examples:
	
	"2": {
		"name": "nextPlayer",
		"description": "",
		"type": "game",
		"action": "stNextPlayer",
		"updateGameProgression": true,
		"transitions": { "endGame": 99, "nextPlayer": 10 }
	},

	"10": {
		"name": "playerTurn",
		"description": "${actplayer} must play a card or pass",
		"descriptionmyturn": "${you} must play a card or pass",
		"type": "activeplayer",
		"possibleactions": [ "playCard", "pass" ],
		"transitions": { "playCard": 2, "pass": 2 }
	},
*/

	// Final state.
	// Please do not modify (and do not overload action/args methods}.
	"99": {
		"name": "gameEnd",
		"description": "End of game",
		"type": "manager",
		"action": "stGameEnd",
		"args": "argGameEnd",
		"argsType": "object" // Automatically typed by framework.
	}
}
