/*
 * This file is enforced by schema file located at 'bga-ts-template/template/schema'. If you are using VS Code, this schema file will be linked to this file automatically if 'generate-vscode-files' is set to true in 'template.config.jsonc. Hover over any fields for more information.
 */
{
	"$schema": "../../node_modules/bga-ts-template/schema/gameoptions.schema.json",

	// Read in Game.php through the 'guessingRule' game state label.
	"100": {
		"name": "Guessing",
		"values": {
			"1": {
				"name": "Standard",
				"description": "Only the player whose turn it is guesses. A correct guess scores 1 point; a wrong guess earns an X."
			},
			"2": {
				"name": "Everyone may join a guess",
				"tmdisplay": "Everyone may join a guess",
				"description": "When a player makes a guess, every other player may secretly guess the same target's identity too, then all guesses are revealed. The original guesser scores 2 points if correct; anyone else who joins scores 1. Every wrong guess earns an X."
			}
		},
		"default": 1
	}
}
